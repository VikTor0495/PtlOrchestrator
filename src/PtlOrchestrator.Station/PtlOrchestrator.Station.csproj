<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- AioiSystems.Lightstep carica System.Windows.Forms dentro Connect: senza, la connessione al PTL fallisce sempre -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PtlStation</AssemblyName>
    <RootNamespace>PtlOrchestrator.Station</RootNamespace>
    <ApplicationIcon>..\..\assets\PTL-Orchestrator.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PtlOrchestrator.Core\PtlOrchestrator.Core.csproj" />
    <ProjectReference Include="..\PtlOrchestrator.Contracts\PtlOrchestrator.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\PTL-Orchestrator.ico" Link="Assets\PTL-Orchestrator.ico" />
    <!-- il logo nella schermata di login usa il PNG: dal .ico WPF prenderebbe il fotogramma più piccolo e lo ingrandirebbe -->
    <Resource Include="..\..\assets\PTL-Orchestrator.png" Link="Assets\PTL-Orchestrator.png" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="System.IO" />
    <!-- Windows Forms serve solo alla DLL Lightstep: i suoi using globali renderebbero ambigui i tipi WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <InternalsVisibleTo Include="PtlOrchestrator.Station.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.13" />
  </ItemGroup>

</Project>
