<UserControl x:Class="PtlOrchestrator.Station.Views.WorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- operatore e comandi di turno -->
        <Border Grid.Row="0" Padding="16,12" Background="#F3F4F6" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="13" Foreground="#6B7280" Text="Operatore" />
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding OperatorName}" />
                    <TextBlock Foreground="#6B7280"
                               Text="{Binding SessionStartedAt, StringFormat='Turno iniziato alle {0:HH:mm}'}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,8,0" Padding="16,10" FontSize="15" Content="Check-in carrello" Click="CheckIn_Click" />
                    <Button Margin="0,0,8,0" Padding="16,10" FontSize="15" Content="Tastiera" Click="Keyboard_Click" />
                    <Button Margin="0,0,8,0" Padding="16,10" FontSize="15" Content="Reset"
                            Command="{Binding CloseWorkCommand}" />
                    <Button Padding="16,10" FontSize="15" Content="Esci" Command="{Binding LogoutCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- esito dell'ultima operazione e input manuale dei codici -->
        <Border Grid.Row="1" Margin="0,12,0,12" Padding="16,12" CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E5E7EB" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LastMessage.Severity}" Value="Success">
                            <Setter Property="Background" Value="#D1FAE5" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LastMessage.Severity}" Value="Warning">
                            <Setter Property="Background" Value="#FEF3C7" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LastMessage.Severity}" Value="Error">
                            <Setter Property="Background" Value="#FEE2E2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding LastMessage.Text}" />
                    <TextBlock Foreground="#6B7280" Text="{Binding LastScanCode, StringFormat='Ultimo codice letto: {0}'}" />
                </StackPanel>

                <!-- stesso effetto della scansione: per prodotti o carrelli, se la pistola è rotta o assente -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBox Width="200" Padding="6" FontSize="16" MaxLength="64" VerticalContentAlignment="Center"
                             ToolTip="Codice a mano (prodotto o carrello)"
                             Text="{Binding CodeInput, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SubmitCodeCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Margin="8,0,0,0" Padding="14,6" FontSize="15" Content="Invia" Command="{Binding SubmitCodeCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- area dei carrelli -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <!-- nessun carrello: invita al check-in -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding NoCarts, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Nessun carrello attivo" />
                    <TextBlock Margin="0,6,0,20" FontSize="16" Foreground="#6B7280" HorizontalAlignment="Center"
                               Text="Fai il check-in di un carrello per iniziare" />
                    <Button Padding="24,12" FontSize="18" HorizontalAlignment="Center" Content="Check-in carrello" Click="CheckIn_Click" />
                </StackPanel>

                <!-- carrelli attivi (al massimo 4): 1, 2 o 3 in fila, 4 in griglia 2x2 -->
                <ItemsControl ItemsSource="{Binding Carts}"
                              Visibility="{Binding HasCarts, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding DataContext.CartColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="6" Padding="14" CornerRadius="8" BorderBrush="#D1D5DB" BorderThickness="1" Background="#FAFAFA">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding CartId, StringFormat='Carrello {0}'}" />
                                            <TextBlock FontSize="12" Foreground="#6B7280" Text="{Binding Controller, StringFormat='controller {0}'}" />
                                        </StackPanel>
                                        <!-- la X rimuove il carrello: possibile solo se è vuoto -->
                                        <Button Grid.Column="1" Width="36" Height="36" FontSize="18" FontWeight="Bold"
                                                Content="✕" VerticalAlignment="Top"
                                                Command="{Binding DataContext.RemoveCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding CartId}"
                                                IsEnabled="{Binding IsEmpty}"
                                                ToolTip="Rimuovi il carrello (solo se vuoto)" />
                                    </Grid>

                                    <ItemsControl Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Baskets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="130" Height="62" Margin="0,0,8,8" Padding="8" CornerRadius="4"
                                                        BorderThickness="1" BorderBrush="#D1D5DB">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="White" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                                                                    <Setter Property="BorderBrush" Value="#10B981" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding BasketId}" />
                                                        <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Display}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- stato del sistema e accesso a impostazioni e diagnostica -->
        <StatusBar Grid.Row="3" Margin="0,12,0,0">
            <StatusBarItem Content="{Binding StationId, StringFormat='Postazione {0}'}" />
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="PTL: non connesso" />
                            <Setter Property="Foreground" Value="#B91C1C" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPtlConnected}" Value="True">
                                    <Setter Property="Text" Value="PTL: connesso" />
                                    <Setter Property="Foreground" Value="#047857" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem Content="{Binding PendingEvents, StringFormat='Eventi da inviare: {0}'}" />
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button Padding="10,2" Margin="0,0,8,0" Content="Impostazioni…" Click="Settings_Click" />
                    <Button Padding="10,2" Content="Diagnostica…" Click="Diagnostics_Click" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Foreground="#B91C1C" Text="{Binding QuarantinedEvents, StringFormat='In quarantena: {0}'}"
                           Visibility="{Binding HasQuarantinedEvents, Converter={StaticResource BoolToVisibility}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
