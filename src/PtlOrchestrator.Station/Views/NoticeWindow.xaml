<Window x:Class="PtlOrchestrator.Station.Views.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True">
    <!-- avviso per l'operatore: non è modale, così pistola e PTL continuano a funzionare -->
    <Border Padding="28" Background="#FEF3C7">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" Foreground="#92400E" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Margin="0,14,0,0" FontSize="18" TextWrapping="Wrap" />
            <Button Margin="0,26,0,0" HorizontalAlignment="Right" Padding="32,10" FontSize="16"
                    Content="OK" IsDefault="True" IsCancel="True" Click="Ok_Click" />
        </StackPanel>
    </Border>
</Window>
