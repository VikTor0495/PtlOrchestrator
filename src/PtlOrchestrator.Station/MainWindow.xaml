<Window x:Class="PtlOrchestrator.Station.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PTL Station" Icon="/Assets/PTL-Orchestrator.ico" Width="1100" Height="720" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Operatore, input dei codici e comandi di turno -->
        <Border Grid.Row="0" Padding="16" Background="#F3F4F6" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="14" Foreground="#6B7280" Text="Operatore" />
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding OperatorName, FallbackValue='Nessun turno attivo', TargetNullValue='Nessun turno attivo'}" />
                    <TextBlock Foreground="#6B7280"
                               Text="{Binding SessionStartedAt, StringFormat='Turno iniziato alle {0:HH:mm}'}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!-- stesso effetto della scansione: badge operatore, carrello o prodotto -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBox Width="220" Margin="0,0,8,0" Padding="4" FontSize="16" MaxLength="64"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding CodeInput, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SubmitCodeCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Padding="16,6" Content="Invia" Command="{Binding SubmitCodeCommand}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Padding="12,6" Margin="0,0,8,0" Content="Chiudi sventagliamento"
                                Command="{Binding CloseWorkCommand}" />
                        <Button Padding="12,6" Content="Esci dal turno" Command="{Binding LogoutCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Esito dell'ultima operazione -->
        <Border Grid.Row="1" Margin="0,12,0,12" Padding="16" CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E5E7EB" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LastMessage.Severity}" Value="Success">
                            <Setter Property="Background" Value="#D1FAE5" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LastMessage.Severity}" Value="Warning">
                            <Setter Property="Background" Value="#FEF3C7" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LastMessage.Severity}" Value="Error">
                            <Setter Property="Background" Value="#FEE2E2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding LastMessage.Text}" />
                <TextBlock Foreground="#6B7280" Text="{Binding LastScanCode, StringFormat='Ultimo codice letto: {0}'}" />
            </StackPanel>
        </Border>

        <!-- Carrelli attivi e cestelli -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <!-- senza login non si mostra altro che l'accesso -->
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>
                <TextBlock Margin="0,0,0,8" Foreground="#6B7280" FontSize="14"
                           Text="Nessun carrello attivo: fai il check-in scansionando o digitando il numero di un carrello."
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Carts.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Carts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding CartId, StringFormat='Carrello {0}'}" />
                                    <TextBlock Margin="12,3,0,0" Foreground="#6B7280" Text="{Binding Controller, StringFormat='controller {0}'}" />
                                    <Button Margin="16,0,0,0" Padding="8,2" Content="Rimuovi carrello"
                                            Command="{Binding DataContext.RemoveCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding CartId}"
                                            IsEnabled="{Binding IsEmpty}"
                                            ToolTip="Possibile solo con il carrello vuoto" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Baskets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="150" Height="64" Margin="0,6,8,0" Padding="8" CornerRadius="4"
                                                    BorderThickness="1" BorderBrush="#D1D5DB">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="White" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                                <Setter Property="Background" Value="#FEF3C7" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                                                                <Setter Property="BorderBrush" Value="#10B981" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding BasketId}" />
                                                    <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Display}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Stato del sistema -->
        <StatusBar Grid.Row="3" Margin="0,12,0,0">
            <StatusBar.Style>
                <Style TargetType="StatusBar">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StatusBar.Style>
            <StatusBarItem Content="{Binding StationId, StringFormat='Postazione {0}'}" />
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="PTL: non connesso" />
                            <Setter Property="Foreground" Value="#B91C1C" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPtlConnected}" Value="True">
                                    <Setter Property="Text" Value="PTL: connesso" />
                                    <Setter Property="Foreground" Value="#047857" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem Content="{Binding PendingEvents, StringFormat='Eventi da inviare: {0}'}" />
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button Padding="10,2" Margin="0,0,8,0" Content="Impostazioni…" Click="Settings_Click" />
                    <Button Padding="10,2" Content="Diagnostica…" Click="Diagnostics_Click" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Foreground="#B91C1C" Text="{Binding QuarantinedEvents, StringFormat='In quarantena: {0}'}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasQuarantinedEvents}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
