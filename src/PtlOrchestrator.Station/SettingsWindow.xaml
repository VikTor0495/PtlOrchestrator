<Window x:Class="PtlOrchestrator.Station.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni postazione" Width="640" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Impostazioni postazione" />
        <TextBlock Margin="0,4,0,12" Foreground="#6B7280" TextWrapping="Wrap"
                   Text="Le modifiche vengono salvate con lo storico e valgono dopo il riavvio della postazione. Lasciare vuoto l'identificativo per usare quello automatico della macchina." />

        <Grid x:Name="FieldsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>

        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Padding="16,6" Margin="0,0,8,0" Content="Chiudi" Click="Close_Click" />
            <Button Padding="16,6" Margin="0,0,8,0" Content="Salva" Click="Save_Click" />
            <Button Padding="16,6" Content="Salva e riavvia" Click="SaveAndRestart_Click" />
        </StackPanel>
    </StackPanel>
</Window>
